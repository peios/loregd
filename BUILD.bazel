load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_path", "go_test")
load("//packages:package.bzl", "package_store")

package(default_visibility = ["//:__subpackages__"])

# gazelle:prefix github.com/peios/loregd
# gazelle:exclude third_party
# gazelle:exclude out
# gazelle:exclude build
# gazelle:exclude packages
# gazelle:exclude docs
# gazelle:exclude tools
# gazelle:go_naming_convention go_default_library
gazelle(name = "gazelle")

go_library(
    name = "go_default_library",
    srcs = ["main.go"],
    importpath = "github.com/peios/loregd",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config:go_default_library",
        "//internal/device:go_default_library",
        "//internal/handler:go_default_library",
        "//internal/hivedb:go_default_library",
        "//internal/rsi:go_default_library",
    ],
)

go_binary(
    name = "loregd",
    embed = [":go_default_library"],
    gc_linkopts = [
        "-B",
        "gobuildid",
        "-bindnow",
    ],  # keep
    linkmode = "pie",
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
)

go_path(
    name = "go-sources",
    include_data = False,
    mode = "copy",
    deps = [":loregd"],
)

filegroup(
    name = "package-data",
    srcs = [
        "LICENSE",
        "docs/man/loregd.8",
        "//third_party/licenses:all",
    ],
)

filegroup(
    name = "package-sources",
    srcs = glob(
        [
            ".github/**",
            ".gitignore",
            "*.go",
            "go.*",
            "README.md",
            "LICENSE",
            "SECURITY.md",
            ".bazel*",
            "MODULE.bazel*",
            "bazel",
            "docs/**",
            "tools/**",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "docs/learn/dist/**",
        ],
    ) + [
        "BUILD.bazel",
        "//build:sources",
        "//packages:sources",
        "//third_party/licenses:BUILD.bazel",
        "//third_party/licenses:all",
        "//third_party/ppk:sources",
    ] + ["//internal/" + name + ":sources" for name in [
        "config",
        "device",
        "fold",
        "handler",
        "hivedb",
        "rsi",
        "sd",
    ]],
)

package_store(
    name = "packages",
    packages = [
        "//packages:loregd",
        "//packages:loregd-debuginfo",
        "//packages:loregd-debugsource",
        "//packages:loregd-source",
    ],
)
