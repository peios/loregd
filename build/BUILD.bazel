load("@rules_go//go:def.bzl", "nogo")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "rules-rust-system-libraries.patch",
])

config_setting(
    name = "native",
    values = {"define": "peios_native=true"},
)

constraint_setting(
    name = "libc",
    default_constraint_value = ":libc-gnu",
)

constraint_value(
    name = "libc-gnu",
    constraint_setting = ":libc",
)

nogo(
    name = "vet",
    vet = True,
)

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)
