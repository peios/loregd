{
    "package": {
        "name": "dev.peios.loregd",
        "version": "0.21.13-1",
        "architecture": "x86_64",
        "license": "MIT AND BSD-2-Clause AND BSD-3-Clause AND (MIT OR GPL-2.0-only WITH Linux-syscall-note)",
        "license_class": "free",
        "homepage": "https://github.com/peios/loregd",
        "description": "Peios local registry source daemon"
    },
    "files": {
        "source:LICENSE": "usr/share/licenses/dev.peios.loregd/LICENSE",
        "stage:licenses/**": "usr/share/licenses/dev.peios.loregd/third-party",
        "stage:usr/sbin/loregd": "usr/sbin/loregd",
        "stage:usr/share/man/**": "usr/share/man",
        "stage:var/state/loregd": "var/state/loregd"
    },
    "dependencies": {
        "org.gnu.glibc": "*"
    },
    "executables": ["usr/sbin/loregd"],
    "side_effects": ["man-db"],
    "provides": {
        "registryd": "1"
    },
    "claims": {
        "provides": {
            "registryd": {
                "binary": {
                    "target": "/usr/sbin/loregd"
                }
            }
        }
    },
    "sd_overrides": {
        "var/state/loregd": "O:SYG:SYD:P(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)"
    },
    "directory_modes": {
        "var/state/loregd": "0700"
    }
}
