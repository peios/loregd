load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:checks.bzl", "host_test")
load(":build.bzl", "daemon_stage")
load(":package.bzl", "daemon_package", "package_store_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    deps = [
        "@ppk_crates//:anyhow",
        "@ppk_crates//:sha2",
        "@ppk_crates//:zstd",
    ],
)

daemon_stage(
    name = "stage",
    binary = "//:loregd",
    data = ["//:package-data"],
    driver = "stage.py",
    drivers = ["stage.py"],
    go_sources = "//:go-sources",
    native = select({
        "//build:native": True,
        "//conditions:default": False,
    }),
)

[daemon_package(
    name = "loregd" + suffix,
    srcs = ["//:package-data"],
    definition = "definitions/loregd" + suffix + ".json",
    stage = ":stage",
) for suffix in [
    "",
    "-debuginfo",
    "-debugsource",
]]

daemon_package(
    name = "loregd-source",
    srcs = ["//:package-sources"],
    source = True,
    stage = ":stage",
)

host_test(
    name = "assembly-test",
    command = "exec python3 packages/test_assembly.py",
    data = [
        "assembly.py",
        "test_assembly.py",
    ],
)

package_store_test(
    name = "store-test",
    srcs = [
        "assembly.py",
        "package.py",
    ],
    main = "test_store.py",
)
