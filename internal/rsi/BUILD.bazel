load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "clock.go",
        "constants.go",
        "dispatch.go",
        "messages.go",
        "wire.go",
    ],
    importpath = "github.com/peios/loregd/internal/rsi",
    visibility = ["//:__subpackages__"],
    deps = ["@org_golang_x_sys//unix:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "begin_mode_test.go",
        "dispatch_test.go",
        "messages_test.go",
        "wire_test.go",
    ],
    embed = [":go_default_library"],
)

filegroup(
    name = "sources",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
