load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "device.go",
        "lifetime.go",
    ],
    importpath = "github.com/peios/loregd/internal/device",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/rsi:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = ["device_test.go"],
    embed = [":go_default_library"],
    deps = ["//internal/rsi:go_default_library"],
)

filegroup(
    name = "sources",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
