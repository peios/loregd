load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "handler.go",
        "keys.go",
        "lease.go",
        "paths.go",
        "querier.go",
        "request.go",
        "routing.go",
        "txn.go",
        "txn_handlers.go",
        "values.go",
    ],
    importpath = "github.com/peios/loregd/internal/handler",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/fold:go_default_library",
        "//internal/hivedb:go_default_library",
        "//internal/rsi:go_default_library",
        "@org_modernc_sqlite//:go_default_library",
        "@org_modernc_sqlite//lib:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "begin_mode_test.go",
        "contention_test.go",
        "determinism_test.go",
        "handler_test.go",
        "hide_entry_test.go",
        "lease_test.go",
        "readonly_txn_test.go",
        "schema_routing_test.go",
        "txn_handlers_test.go",
        "values_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//internal/fold:go_default_library",
        "//internal/hivedb:go_default_library",
        "//internal/rsi:go_default_library",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
