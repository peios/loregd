load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["config.go"],
    importpath = "github.com/peios/loregd/internal/config",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/fold:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = ["config_test.go"],
    embed = [":go_default_library"],
)

filegroup(
    name = "sources",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
